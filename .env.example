# Copy to .env for local dev. Never commit real secrets.
# Milestone 0 only: variable names are a proposal and may change after review.

# --- AWS target ---
AWS_REGION=
S3_ARTIFACT_BUCKET=
AWS_SECRETS_PREFIX=

# --- PostgreSQL / Amazon RDS target ---
DATABASE_URL=

# --- LLM provider (whichever is chosen in ADR) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- App ---
APP_ENV=local
APP_LOG_LEVEL=INFO
# Tenant and actor must come from authenticated server-side identity; no default tenant.

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=stockoutops-live
CLOUDWATCH_LOG_GROUP=

# --- Feature flags ---
FEATURE_AGENT_ENABLED=false
FEATURE_CANARY_PERCENTAGE=0
