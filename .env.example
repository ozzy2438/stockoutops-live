# Copy to .env for local development. Never commit .env or generated identity files.
+# Values below are conspicuously local-only; they are not production credentials.
+
+APP_ENV=local
+IDENTITY_PROVIDER=simulated
+SIMULATED_IDENTITIES_FILE=.local/identities.json
+REASONING_PROVIDER=stub
+
+DATABASE_URL=postgresql://stockoutops_app:app-local-only@localhost:5432/stockoutops
+MIGRATION_DATABASE_URL=postgresql://stockoutops_migration:migration-local-only@localhost:5432/stockoutops
+APP_DB_PASSWORD=app-local-only
+
