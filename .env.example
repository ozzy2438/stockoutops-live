# Copy to .env for local dev. Never commit real secrets.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- LLM provider (whichever is chosen in ADR) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- App ---
APP_ENV=local
APP_TENANT_DEFAULT=
APP_LOG_LEVEL=INFO

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=stockoutops-live

# --- Feature flags ---
FEATURE_AGENT_ENABLED=false
FEATURE_CANARY_PERCENTAGE=0
